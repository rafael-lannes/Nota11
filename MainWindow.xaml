<Window x:Class="Nota11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nota 11 - Game Tracker &amp; Masterpieces"
        Height="880" 
        Width="1400"
        MinHeight="600"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#090a0f"
        Foreground="#f1f5f9"
        FontFamily="Segoe UI, Inter, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Configuração do WindowChrome para bordas de redimensionamento e barra customizada -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Estilo base dos botões da barra de título -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1b202e" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#242b3d" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo especial do botão Fechar (Hover Vermelho Gamer) -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#e11d48" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#be123c" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Container Raiz com ajuste de padding quando maximizado -->
    <Border x:Name="RootBorder" Background="#090a0f" BorderBrush="#1a1f2c" BorderThickness="1">
        <Grid Background="#090a0f">
            <Grid.RowDefinitions>
                <!-- Linha da Barra de Título Customizada (38px) -->
                <RowDefinition Height="38" />
                <!-- Linha Principal da Aplicação (WebView2) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================
                 BARRA DE TÍTULO CUSTOMIZADA (Estilo Nota 11 Gamer / Dark)
                 ============================================================ -->
            <Border Grid.Row="0"
                    Background="#0d1017"
                    BorderBrush="#1e2433"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Bloco Esquerda: Logo Nota 11 + Título + Badges -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Bloco Central: Área de Arraste da Janela -->
                        <ColumnDefinition Width="*" />
                        <!-- Bloco Direita: Botões de Controle (Recarregar, Minimizar, Maximizar, Fechar) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bloco Esquerda: Identidade Visual Nota 11 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Mini Emblema Dourado 11 -->
                        <Border Width="24" Height="24" CornerRadius="6" BorderBrush="#f59e0b" BorderThickness="1.2" Margin="0,0,8,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#f59e0b" Offset="0.0" />
                                    <GradientStop Color="#d97706" Offset="0.6" />
                                    <GradientStop Color="#b45309" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="11"
                                       FontWeight="Black"
                                       FontSize="12"
                                       Foreground="#090a0f"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,1" />
                        </Border>

                        <!-- Nome da Aplicação com 11 Dourado -->
                        <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold">
                            <Run Text="NOTA " Foreground="#f8fafc" FontWeight="ExtraBold" />
                            <Run Text="11" Foreground="#f59e0b" FontWeight="Black" />
                        </TextBlock>

                        <!-- Divisor Vertical Sutil -->
                        <Rectangle Width="1" Height="14" Fill="#222738" Margin="10,0,10,0" VerticalAlignment="Center" />

                        <!-- Subtítulo Discreto -->
                        <TextBlock Text="Game Tracker &amp; Masterpieces"
                                   Foreground="#64748b"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />

                        <!-- Badge Desktop Windows -->
                        <Border Background="#141824"
                                BorderBrush="#242b3d"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#10b981" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="DESKTOP"
                                           Foreground="#94a3b8"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bloco Central: Área Transparente para Arrastar Janela -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Bloco Direita: Botões de Ação e Janela (HitTestVisible habilitado) -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                VerticalAlignment="Stretch">
                        
                        <!-- Botão Recarregar (F5) -->
                        <Button x:Name="BtnReload"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Recarregar Interface (F5)"
                                Click="BtnReload_Click">
                            <Path Data="M 2.5 7.5 A 5 5 0 1 1 7.5 12.5 M 7.5 10 L 7.5 13 L 4.5 13"
                                  Stroke="#94a3b8"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="11"
                                  Height="11"
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Botão Minimizar -->
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Minimizar"
                                Click="BtnMinimize_Click">
                            <Rectangle Width="10" Height="1.5" Fill="#94a3b8" />
                        </Button>

                        <!-- Botão Maximizar / Restaurar -->
                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Maximizar"
                                Click="BtnMaximize_Click">
                            <Path x:Name="MaximizeIconPath"
                                  Data="M 1,1 L 9,1 L 9,9 L 1,9 Z"
                                  Stroke="#94a3b8"
                                  StrokeThickness="1.3"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Botão Fechar -->
                        <Button x:Name="BtnClose"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="Fechar Aplicativo"
                                Click="BtnClose_Click">
                            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="#94a3b8"
                                  StrokeThickness="1.4"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 CONTAINER PRINCIPAL (WebView2 com Fundo Escuro Gamer)
                 ============================================================ -->
            <Border Grid.Row="1" Background="#090a0f">
                <wv2:WebView2 x:Name="WebView" />
            </Border>
        </Grid>
    </Border>
</Window>
